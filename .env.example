# PayPal sandbox credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' (default) or 'live'. Leave as sandbox.
PAYPAL_ENV=sandbox
# Webhook id from the PayPal app, used to verify inbound webhook signatures.
PAYPAL_WEBHOOK_ID=

# Optional. Without it the project runs on the offline scorer, which is weaker
# but fully deterministic. Everything is runnable without this key.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
SECOND_THOUGHT_MODEL=
