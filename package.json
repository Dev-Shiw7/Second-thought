{
  "name": "second-thought",
  "version": "0.1.0",
  "description": "Scam-narrative detection for vulnerable adults, built on PayPal.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "tsx src/seed/generate.ts",
    "classify": "tsx src/engine/cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "verify:paypal": "tsx src/paypal/verify-adapter.ts",
    "test": "tsx src/engine/cli.ts --all --offline && tsx src/paypal/verify-adapter.ts"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
